{
  "name": "J.A.R.V.I.S.",
  "short_name": "Jarvis",
  "description": "Assistente pessoal com voz, rotinas e widgets.",
  "lang": "pt-BR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#03080c",
  "theme_color": "#03080c",
  "icons": [
    {"src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "shortcuts": [
    {"name": "Falar com o Jarvis", "short_name": "Falar", "url": "./?acao=falar", "icons": [{"src": "icon-192.png", "sizes": "192x192", "type": "image/png"}]},
    {"name": "Novo lembrete", "short_name": "Lembrete", "url": "./?acao=lembrete", "icons": [{"src": "icon-192.png", "sizes": "192x192", "type": "image/png"}]},
    {"name": "Timer", "short_name": "Timer", "url": "./?acao=timer", "icons": [{"src": "icon-192.png", "sizes": "192x192", "type": "image/png"}]},
    {"name": "Estudo", "short_name": "Estudo", "url": "./?acao=estudo", "icons": [{"src": "icon-192.png", "sizes": "192x192", "type": "image/png"}]}
  ],
  "share_target": {
    "action": "./compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "url": "url",
      "files": [{"name": "arquivo", "accept": ["application/pdf", "image/*", "text/plain"]}]
    }
  }
}
